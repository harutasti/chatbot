project_name = "chatbot-poc"
environment  = "dev"
aws_region   = "ap-northeast-1"

# Confirm model access in Amazon Bedrock before terraform apply.
bedrock_model_id    = "qwen.qwen3-235b-a22b-2507-v1:0"
embedding_model_id  = "amazon.titan-embed-text-v2:0"
embedding_dimensions = 1024

# CloudFront is allowed automatically. Add localhost only while developing locally.
# cors_additional_origins = ["http://localhost:5173"]
# cognito_additional_callback_urls = ["http://localhost:5173/"]
# cognito_additional_logout_urls   = ["http://localhost:5173/"]

# Override only if the generated globally unique Cognito domain is unavailable.
# cognito_domain_prefix = "my-company-chatbot-dev"
